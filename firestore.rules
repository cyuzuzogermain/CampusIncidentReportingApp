rules_version = '2';

// Firestore security rules for the Campus Incident Reporting App.
//
// The app hides staff-only controls from students, but the UI is not a
// security boundary. These rules are what actually enforce who can read and
// write what.
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Staff status comes from the caller's own user document, which only an
    // admin can change (see the users rules below). Each get() counts as one
    // document read.
    function isStaff() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn()
        && exists(userPath)
        && get(userPath).data.role == 'staff';
    }

    // Fields a client may write when changing an incident's status.
    function onlyStatusFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'updatedAt', 'statusHistory']);
    }

    // Staff move a report one step forward, or reject it while it is open.
    function isAllowedTransition(from, to) {
      return (from == 'submitted' && to in ['in_progress', 'rejected'])
        || (from == 'in_progress' && to in ['resolved', 'rejected']);
    }

    // Staff change the status, appending exactly one statusHistory entry
    // for the new status. Its comment is optional (at most 500 characters)
    // but a rejection must give a reason.
    function isStaffStatusChange() {
      let before = resource.data.statusHistory;
      let after = request.resource.data.statusHistory;
      let entry = after[after.size() - 1];
      let comment = entry.get('comment', '');
      return isStaff()
        && onlyStatusFieldsChanged()
        && isAllowedTransition(resource.data.status,
                               request.resource.data.status)
        && after.size() == before.size() + 1
        && entry.status == request.resource.data.status
        && comment is string
        && comment.size() <= 500
        && (request.resource.data.status != 'rejected' || comment.size() > 0);
    }

    function isReporter() {
      return isSignedIn() && resource.data.reporterId == request.auth.uid;
    }

    // The editable fields hold valid values.
    function hasValidContent(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 60
        && data.category in
             ['facilities', 'water', 'electricity', 'safety', 'sanitation'];
    }

    // The reporter edits a report staff haven't started on yet. Status,
    // history, reporter and the affected list stay as they are.
    function isReporterEdit() {
      return isReporter()
        && resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'description', 'category', 'location',
                       'imageUrl', 'updatedAt'])
        && hasValidContent(request.resource.data);
    }

    // Another student adds or removes only their own uid from
    // affectedUserIds. Joining is closed once the issue is resolved or
    // rejected.
    function isAffectedToggle() {
      let uid = request.auth.uid;
      let before = resource.data.get('affectedUserIds', []);
      let after = request.resource.data.affectedUserIds;
      let joins = !(uid in before)
        && !(resource.data.status in ['resolved', 'rejected'])
        && after.toSet() == before.toSet().union([uid].toSet())
        && after.size() == before.size() + 1;
      let leaves = uid in before
        && before.toSet() == after.toSet().union([uid].toSet())
        && after.size() == before.size() - 1;
      return isSignedIn()
        && !isReporter()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['affectedUserIds'])
        && after is list
        && (joins || leaves);
    }

    // ---------- users/{uid} ----------
    // name, email, role ("student" | "staff"), department, createdAt
    match /users/{uid} {
      // You can read your own profile. Staff can read anyone's (e.g. to
      // see who filed a report).
      allow read: if isOwner(uid) || isStaff();

      // You can only create your own profile, and it must be a student.
      // Staff accounts are promoted by hand in the Firebase console, which
      // bypasses these rules.
      allow create: if isOwner(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.keys()
             .hasOnly(['name', 'email', 'role', 'department', 'createdAt']);

      // You may edit your own profile, but never the role field. This stops
      // a student from making themselves staff.
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role']);

      allow delete: if false;
    }

    // ---------- incidents/{incidentId} ----------
    // title, description, category, location, imageUrl, status, reporterId,
    // reporterName, createdAt, updatedAt, statusHistory
    match /incidents/{incidentId} {
      // Every signed-in user can read every incident: students see their
      // classmates' reports read-only on the Campus Reports tab.
      allow read: if isSignedIn();

      // Any signed-in user can file a report, but only as themselves and
      // only with the starting status, so nobody can file one already
      // "resolved".
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.keys().hasOnly([
             'title', 'description', 'category', 'location', 'imageUrl',
             'status', 'reporterId', 'reporterName', 'createdAt',
             'updatedAt', 'statusHistory', 'affectedUserIds'
           ])
        && hasValidContent(request.resource.data)
        && request.resource.data.get('affectedUserIds', []).size() == 0
        && request.resource.data.statusHistory is list
        && request.resource.data.statusHistory.size() == 1;

      // Three kinds of update:
      // - staff move the status forward or reject the report, adding
      //   exactly one statusHistory entry;
      // - the reporter edits the content while the report is still
      //   submitted;
      // - another student marks or unmarks themselves as affected.
      allow update: if isStaffStatusChange()
        || isReporterEdit()
        || isAffectedToggle();

      // The reporter can withdraw a report until staff start on it. After
      // that it is a permanent record.
      allow delete: if isReporter() && resource.data.status == 'submitted';
    }
  }
}
